# ===== F1 STACKMIND Cyber Academy — environment variables =====

# 1) Create a project at https://supabase.com
# 2) Copy these from Settings → API in the Supabase dashboard:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 3) Service Role key — from Settings → API → service_role.
#    NEVER expose this to the browser. Used only on the server.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 4) A secret code used to register additional mentors at signup.
#    Give it only to trusted mentors.
MENTOR_ACCESS_CODE=change-me-to-a-long-random-string